# Copy to .env and fill in real values. Never commit .env.
# The worker uses the backend's settings for everything shared (database, keys, channels) —
# keep these values the SAME as the backend's .env.

# --- Scheduler (worker only) ---
SCHEDULER_ENABLED=false
PIPELINE_CRON=0 6 * * *
RAPID_CHECK_CRON=0 */3 * * *
OFFICER_SUMMARY_CRON=15 7 * * *

# --- Database (same database as the backend) ---
DATABASE_URL=postgresql+psycopg://Sharksss:Sharksss123@localhost:6000/monsoon

# --- Security (same values as the backend) ---
PHONE_ENC_KEY=
PHONE_HASH_PEPPER=change-me

# --- Data sources ---
DATA_DIR=./data
MODEL_DIR=./data/models
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
RAPID_SAMPLE_POINTS=5
NCEP_R1_OPENDAP_URL=
OLR_OPENDAP_URL=

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_ENABLED=false
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=

# --- SMS (Android SMS gateway app) ---
SMS_ENABLED=false
SMS_GATEWAY_URL=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=
SMS_DAILY_CAP=300

# --- Scope ---
GP_DISTRICT=
